.venv/
__pycache__/
*.pyc
.DS_Store

# Secrets must never be committed (real password lives in Streamlit Cloud).
.streamlit/secrets.toml

# SQLite DBs are local-only: they are derived from a licensed Clarity AI
# dataset and should not be redistributed. Rebuild with src/build_sqlite.py
# if you hold a licence to the source data.
outputs/*.db
outputs/esg_full.db

# NOTE: outputs/*.parquet ARE committed on purpose — the app reads them at
# runtime and does not regenerate them. Do not ignore them.
outputs/carbon_panel.parquet
